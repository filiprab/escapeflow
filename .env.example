# Environment variables for EscapeFlow application

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=escapeflow
POSTGRES_USER=escapeflow
POSTGRES_PASSWORD=<GENERATE_A_STRONG_PASSWORD>

# Application Port (default: 3000)
PORT=3000

# Database Connection URLs
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&sslmode=prefer"
DATABASE_URL_DOCKER="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&sslmode=prefer"

# Optional NVD API key for higher rate limits
# NVD_API_KEY="your-key"
